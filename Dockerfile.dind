# syntax=docker/dockerfile:1
FROM docker:dind

USER root

ARG TARGETARCH

# Install runtime deps + Node.js + BuildKit
RUN set -eux; \
    apk add --no-cache bash ca-certificates curl jq xz; \
    update-ca-certificates; \
    if apk add --no-cache nodejs-current npm; then :; else apk add --no-cache nodejs npm; fi; \
    if apk add --no-cache buildkit; then :; else \
      echo "apk buildkit not available; installing from upstream release"; \
      api="https://api.github.com/repos/moby/buildkit/releases/latest"; \
      tag="$(curl -fsSL "$api" | jq -r .tag_name)"; \
      case "${TARGETARCH:-amd64}" in \
        amd64) bk_arch="amd64" ;; \
        arm64) bk_arch="arm64" ;; \
        *) echo "Unsupported TARGETARCH=${TARGETARCH}"; exit 1 ;; \
      esac; \
      url="https://github.com/moby/buildkit/releases/download/${tag}/buildkit-${tag}.linux-${bk_arch}.tar.gz"; \
      curl -fsSL "$url" -o /tmp/buildkit.tgz; \
      tar -C /usr/local -xzf /tmp/buildkit.tgz; \
      rm -f /tmp/buildkit.tgz; \
      buildkitd --version; \
      buildctl --version; \
	  mkdir -p /etc/buildkit/certs; \
    fi

# Download latest act_runner from gitea.com releases
# (we query the Gitea API for the latest tag, then download the right arch asset)
RUN set -eux; \
    api="https://gitea.com/api/v1/repos/gitea/act_runner/releases/latest"; \
    tag="$(curl -fsSL "$api" | jq -r .tag_name)"; \
    ver="${tag#v}"; \
    case "${TARGETARCH:-amd64}" in \
      amd64) arch="amd64" ;; \
      arm64) arch="arm64" ;; \
      *) echo "Unsupported TARGETARCH=${TARGETARCH}"; exit 1 ;; \
    esac; \
    url="https://gitea.com/gitea/act_runner/releases/download/${tag}/act_runner-${ver}-linux-${arch}.xz"; \
    curl -fsSL "$url" -o /tmp/act_runner.xz; \
    xz -d /tmp/act_runner.xz; \
    install -m 0755 /tmp/act_runner /usr/local/bin/act_runner; \
    rm -f /tmp/act_runner; \
    act_runner --version || true

# Create dedicated user/group for act_runner (after installation)
RUN addgroup -S act_runner \
    && adduser -S -G act_runner -h /var/lib/act_runner -s /sbin/nologin act_runner \
  && mkdir -p /var/lib/act_runner

# Make runner state dir writable for the rootless runtime user
RUN mkdir -p /var/lib/act_runner \
  && chown -R act_runner:act_runner /var/lib/act_runner

COPY ./config.yaml /etc/act_runner/config.yaml
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# DinD images already have an entrypoint, we override to start dockerd + runner.
ENTRYPOINT ["/entrypoint.sh"]
